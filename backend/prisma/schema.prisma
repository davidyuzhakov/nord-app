generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  passwordHash      String
  fullName          String
  activeChurchId    String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          Session[]
  churchMemberships ChurchMember[]

  createdChurches Church[] @relation("creater")
  activeChurch    Church?  @relation("current", fields: [activeChurchId], references: [id], onDelete: SetNull)
}

model Session {
  tokenHash String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Church {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  createdById String         @db.Uuid
  createdBy   User           @relation("creater", fields: [createdById], references: [id], onDelete: Restrict)
  inviteToken String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     ChurchMember[]
  activeUsers User[]         @relation("current")
}

model ChurchMember {
  userId   String   @db.Uuid
  churchId String   @db.Uuid
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  church   Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@id([userId, churchId])
  @@index([churchId])
}

model Song {
  id           Int           @id @default(autoincrement())
  name         String
  key          String
  bpm          Int
  text         String
  audio        String?
  danceVideo   String?
  structure    Json?
  programSongs ProgramSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramSong {
  id        Int     @id @default(autoincrement())
  programId Int
  program   Program @relation(fields: [programId], references: [id])
  songId    Int
  song      Song    @relation(fields: [songId], references: [id], onDelete: Cascade)
  order     Int
  key       String?

  @@unique([programId, songId])
  @@index([programId, order])
}

model Program {
  id         Int           @id @default(autoincrement())
  name       String
  songs      ProgramSong[]
  date       DateTime?
  isFavorite Boolean       @default(false)
  isArchived Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}
